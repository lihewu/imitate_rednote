<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 可通过 logging.file.path 或环境变量 LOGGING_FILE_PATH 指定日志目录 -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path"
                    defaultValue="./logs/rednote-auth" />
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Shanghai} [%thread] %-5level %logger{50} - %msg%n%ex" />

    <!-- 控制台日志，便于在 IDEA 和容器中查看 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 文件写入仅由 ASYNC_FILE 调用 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/rednote-auth.log</file>
        <append>true</append>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/rednote-auth.%d{yyyy-MM-dd,Asia/Shanghai}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 每个 AsyncAppender 使用一个后台工作线程消费有界队列 -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <!-- 关闭队列接近满时主动丢弃 TRACE、DEBUG、INFO 日志的策略 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 队列满时等待可用空间 -->
        <neverBlock>false</neverBlock>
        <includeCallerData>false</includeCallerData>
        <!-- 正常关闭时最多等待 5 秒处理队列中的日志 -->
        <maxFlushTime>5000</maxFlushTime>
        <appender-ref ref="FILE" />
    </appender>

    <!-- 更细粒度的级别继续由 application-*.yml 中的 logging.level 控制 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ASYNC_FILE" />
    </root>
</configuration>
